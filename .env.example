SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# All three wallets must be different. Public addresses only; never store keypairs.
CREATOR_PUBLIC_KEY=
PROVIDER_PUBLIC_KEY=
WORKER_TOKEN=
WORKER_URL=http://worker:8000
DATABASE_PATH=/data/alloc.sqlite
UPLOAD_DIR=/data/uploads
APP_ORIGIN=http://localhost:3000
# Optional public-host overlay: a real DNS hostname, no scheme (e.g. alloc.example.org).
# Only required by compose.https.yaml, not by local Docker Compose.
PUBLIC_DOMAIN=
# Optional fallback must also target Devnet.
SOLANA_RPC_FALLBACK_URL=
